{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::shreeyansh-p22-archive-590507089733-20261124121500",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["logs/", "logs/*"]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::shreeyansh-p22-archive-590507089733-20261124121500/logs/*"
    }
  ]
}
